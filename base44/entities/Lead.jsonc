{
  "name": "Lead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome Completo do usu\u00e1rio"
    },
    "whatsapp": {
      "type": "string",
      "description": "N\u00famero de WhatsApp"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail de contato"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "contatado",
        "convertido",
        "arquivado"
      ],
      "default": "novo",
      "description": "Status do lead"
    }
  },
  "required": [
    "full_name",
    "email",
    "whatsapp"
  ]
}